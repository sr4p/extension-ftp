{
  "name": "remote-ftp-sync",
  "displayName": "Remote FTP Sync",
  "description": "Edit FTP and SFTP files directly in Cursor and sync on save.",
  "version": "0.1.0",
  "publisher": "sr4p",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Other"],
  "main": "./src/extension.js",
  "activationEvents": ["onFileSystem:ftp-sync", "onFileSystem:sftp-sync", "onCommand:remoteFtpSync.connect", "onCommand:remoteFtpSync.forgetPassword"],
  "contributes": {
    "commands": [
      { "command": "remoteFtpSync.connect", "title": "FTP/SFTP: Connect to Server" },
      { "command": "remoteFtpSync.forgetPassword", "title": "FTP/SFTP: Forget Saved Password" }
    ],
    "configuration": {
      "title": "Remote FTP Sync",
      "properties": {
        "remoteFtpSync.servers": {
          "type": "array", "default": [], "description": "FTP and SFTP server profiles. Passwords are requested and stored securely when connecting.",
          "items": { "type": "object", "required": ["name", "protocol", "host", "username"], "properties": {
            "name": { "type": "string", "description": "Unique profile name (letters, numbers, hyphens and underscores)." },
            "protocol": { "type": "string", "enum": ["ftp", "ftps", "sftp"] },
            "host": { "type": "string" }, "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "username": { "type": "string" }, "remotePath": { "type": "string", "default": "/" },
            "hostKeySha256": { "type": "string", "description": "Required SFTP host key SHA256 fingerprint, as shown by ssh-keygen -l -E sha256." },
            "privateKeyPath": { "type": "string", "description": "Local path to an SFTP private key." }
          }}
        }
      }
    }
  },
  "scripts": { "test": "node --test test/*.test.js" },
  "dependencies": { "basic-ftp": "^5.0.5", "ssh2-sftp-client": "^12.0.0" },
  "devDependencies": { "@vscode/vsce": "^3.6.0" }
}
